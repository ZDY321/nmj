{
  "name": "teacher-salary-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "tsc -b && tsc -p tsconfig.performance.json",
    "test": "vitest run",
    "dev:performance": "vite --config vite.performance.config.ts",
    "benchmark": "playwright test --config playwright.performance.config.ts",
    "check:size": "node scripts/check-size.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir artifacts/worker",
    "quality": "npm run check && npm test && npm run build && npm run check:worker && npm run check:size"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.110.0"
  }
}
